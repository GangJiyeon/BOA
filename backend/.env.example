# cp .env.example .env 후 값 채우기. .env는 절대 커밋하지 않는다.

# 각자 PC에 설치한 PostgreSQL(5432)에 접속한다.
# docker compose로 API를 띄우면 docker-compose.yml의 값(host.docker.internal)이 우선 적용된다.
DATABASE_URL=postgresql+psycopg://boa:boa@localhost:5432/boa

CORS_ORIGINS=http://localhost:5173

# 분석에 허용할 최소 얼굴 너비(px). 작게 찍힌 사진은 400으로 거부한다.
MIN_FACE_WIDTH_PX=250

# S3 — 비워두면 이미지 API가 503을 반환한다 (AWS 준비 전까지 비워둬도 됨)
AWS_REGION=ap-northeast-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 계정 — 비회원 IP HMAC 키 (배포 시 무작위 값으로), 쿠키 Secure(배포 시 true)
IP_HASH_SECRET=dev-ip-hash-secret
COOKIE_SECURE=false

# 비회원 하루 횟수 — 기능별 제한(0이면 없음), 같은 IP 합산 상한(대회 때 0)
GUEST_DAILY_LIMIT_SKIN=3
GUEST_DAILY_LIMIT_HAIR=3
IP_DAILY_LIMIT=30

# 키오스크 관리자 코드 — 길고 추측하기 어렵게, 비우면 키오스크 등록 불가
ADMIN_CODE=

# 회원 토큰 — JWT 서명 키(배포 시 무작위 값으로), 토큰 수명(분/일)
JWT_SECRET=dev-jwt-secret-change-me-in-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SIGNUP_TOKEN_MINUTES=10

# 이메일 인증 코드 — 유효시간(분), 최대 시도, 재발송 간격(초)
EMAIL_CODE_MINUTES=10
EMAIL_MAX_ATTEMPTS=5
EMAIL_RESEND_SECONDS=60
# 구글 OAuth — 구글 클라우드 콘솔의 웹 클라이언트 값, 비우면 구글 로그인 503
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=postmessage

# 개발용 로그인 API, 로컬 테스트 시에만 true
DEV_LOGIN=false
