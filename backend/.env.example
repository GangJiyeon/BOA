# cp .env.example .env 후 값 채우기. .env는 절대 커밋하지 않는다.

# docker compose로 실행할 때는 docker-compose.yml의 값(db 컨테이너)이 우선 적용된다.
# 아래 값은 컨테이너 밖(호스트)에서 alembic 등을 직접 실행할 때 쓰인다.
DATABASE_URL=postgresql+psycopg://boa:boa@localhost:5433/boa

CORS_ORIGINS=http://localhost:5173

# S3 — 비워두면 이미지 API가 503을 반환한다 (AWS 준비 전까지 비워둬도 됨)
AWS_REGION=ap-northeast-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
